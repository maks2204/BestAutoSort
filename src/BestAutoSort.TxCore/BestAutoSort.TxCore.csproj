<Project Sdk="Microsoft.NET.Sdk">
  <!-- Чистое ядро транзакционного протокола сундуков. Без Unity/Valheim/BepInEx.
       netstandard2.0 чтобы ссылаться и из мода (net472), и из тестов (net8.0). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>BestAutoSort.TxCore</AssemblyName>
    <RootNamespace>BestAutoSort.TxCore</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>
</Project>
